<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Red: Supabase + tiles OSM. El template de Flutter solo lo declara
         en debug/profile; sin esto el build de RELEASE no tiene internet. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Ubicación aproximada y fina para "paradas cerca mío". -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- La alarma "avisame para bajar" con la pantalla apagada.

         FOREGROUND_SERVICE + _LOCATION: sin un servicio en primer plano de
         tipo `location`, Android congela el proceso al apagar la pantalla y
         el GPS deja de llegar — la alarma nunca se entera de que llegaste.
         Es la limitación que tenía la 1.0. NO habilita ubicación en segundo
         plano (eso es ACCESS_BACKGROUND_LOCATION, que NO pedimos): solo
         mantiene vivo lo que el usuario dejó andando.

         POST_NOTIFICATIONS: la notificación fija del viaje. Si el usuario la
         niega, el servicio corre igual y la alarma funciona; solo no se ve
         el cartelito. Por eso no se pide con un diálogo.

         WAKE_LOCK: encender la pantalla cuando la alarma suena. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- allowBackup="false": lo único que la app guarda en el teléfono es
         cache de datos PÚBLICOS del transporte más los favoritos, y todo eso
         se regenera solo. Subirlo a Drive gasta cuota de backup del usuario
         para nada. NO es una medida de seguridad — ahí no hay ningún dato
         personal; es no ensuciar el backup ajeno.
         Solo este atributo: `allowBackup="false"` ya apaga el Auto Backup y
         el de clave-valor. Agregar además `fullBackupContent` sería decir dos
         veces lo mismo. -->
    <application
        android:label="Ruta Libre"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- El servicio que sostiene el viaje guiado mientras la alarma
             está armada. `exported="false"`: lo arranca y lo para esta app y
             nadie más. Ver TripService.kt. -->
        <service
            android:name=".TripService"
            android:exported="false"
            android:foregroundServiceType="location"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Para abrir el nodo de la parada en OpenStreetMap (url_launcher).
             Desde Android 11 una app no VE las otras a menos que las declare
             acá; sin esto, cualquier consulta de "¿hay con qué abrir esto?"
             contesta que no aunque el teléfono tenga Chrome instalado.
             NO es un permiso: no agrega nada a lo que la app pide al usuario
             (la ficha de Play sigue declarando solo los tres de siempre).
             url_launcher_android no lo trae en su propio manifest. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
